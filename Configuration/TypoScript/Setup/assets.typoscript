page {
    includeCSS {
        bootstrap = https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css
        bootstrap.integrity = sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB
        bootstrap.external = 1
        bootstrap.crossorigin = anonymous
        googleFont = https://fonts.googleapis.com/css2?family=Doppio+One&family=Source+Sans+Pro&display=swap
        googleFont.external = 1
        website = EXT:aws_start_screen/Resources/Public/Css/website.css
    }
    includeJSFooter {
        bootstrap = https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js
        bootstrap.integrity = sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI
        bootstrap.crossorigin = anonymous
        bootstrap.external = 1
    }
}
